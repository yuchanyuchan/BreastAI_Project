POSTGRES_DB=breastai
POSTGRES_USER=breastai
POSTGRES_PASSWORD=breastai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# backend/.env (copy this file to backend/.env and fill in real values)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1

# DATABASE_URL: leave unset for local dev (defaults to SQLite at backend/breastai.db).
# Set to a real PostgreSQL URL in production, e.g. postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=
# PUBLIC_BASE_URL: must be a public, HTTPS URL that Meta's servers can reach to fetch the
# generated image (localhost will NOT work for Instagram/Threads publishing). Use your
# deployed URL (Render/Railway) or a temporary tunnel (e.g. ngrok) for local testing.
PUBLIC_BASE_URL=http://localhost:8000

PUBMED_API_KEY=

SNS_TIMEZONE=Asia/Tokyo
SNS_GENERATE_HOUR=7
SNS_PUBLISH_INTERVAL_MINUTES=30

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# INSTAGRAM_ACCESS_TOKEN: long-lived Facebook Graph API access token for a Meta app with
# instagram_basic + instagram_content_publish + pages_read_engagement permissions, generated
# for the Facebook Page linked to your Instagram Business/Creator account.
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID: the numeric Instagram Business Account ID (not the @handle) -
# find it via GET /me/accounts then GET /{page-id}?fields=instagram_business_account
# (INSTAGRAM_BUSINESS_ACCOUNT_ID is still read as a fallback for existing deployments.)
INSTAGRAM_ACCOUNT_ID=
# Optional: comma-separated hashtags appended to the Instagram caption per account persona.
INSTAGRAM_HASHTAGS_DOCTOR=
INSTAGRAM_HASHTAGS_BEAUTY=

THREADS_ACCESS_TOKEN=
